{
  "contract": "xy.season.TeamSeasonPayload",
  "schema": {
    "$defs": {
      "TeamRow": {
        "additionalProperties": false,
        "properties": {
          "club": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Club",
            "type": "string"
          },
          "draws": {
            "anyOf": [
              {
                "maximum": 38,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Matches drawn",
            "title": "Draws"
          },
          "form": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "W",
                    "D",
                    "L"
                  ],
                  "type": "string"
                },
                "maxItems": 5,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The last results, oldest first, each W, D or L, when the table gives them",
            "title": "Form"
          },
          "goals_against": {
            "minimum": 0,
            "title": "Goals Against",
            "type": "integer"
          },
          "goals_for": {
            "minimum": 0,
            "title": "Goals For",
            "type": "integer"
          },
          "losses": {
            "anyOf": [
              {
                "maximum": 38,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Matches lost",
            "title": "Losses"
          },
          "played": {
            "description": "Matches played",
            "maximum": 38,
            "minimum": 0,
            "title": "Played",
            "type": "integer"
          },
          "wins": {
            "anyOf": [
              {
                "maximum": 38,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Matches won, when the table gives them",
            "title": "Wins"
          }
        },
        "required": [
          "club",
          "played",
          "goals_for",
          "goals_against"
        ],
        "title": "TeamRow",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "The Serie A table: matches played and goals for and against, per club, and where the table gives them\nits record and last results.",
    "properties": {
      "teams": {
        "items": {
          "$ref": "#/$defs/TeamRow"
        },
        "maxItems": 20,
        "minItems": 1,
        "title": "Teams",
        "type": "array"
      }
    },
    "required": [
      "teams"
    ],
    "title": "TeamSeasonPayload",
    "type": "object"
  },
  "version": "1.1.0"
}
