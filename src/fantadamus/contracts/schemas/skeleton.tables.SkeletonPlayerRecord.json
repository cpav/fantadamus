{
  "contract": "skeleton.tables.SkeletonPlayerRecord",
  "schema": {
    "additionalProperties": false,
    "description": "Silver `skeleton_players`: one row per player, the latest by `captured_at`, with its provenance.",
    "properties": {
      "bronze_sha256": {
        "description": "`content_sha256` of the bronze record the row came from",
        "pattern": "^[0-9a-f]{64}$",
        "title": "Bronze Sha256",
        "type": "string"
      },
      "captured_at": {
        "format": "date-time",
        "title": "Captured At",
        "type": "string"
      },
      "club": {
        "minLength": 1,
        "title": "Club",
        "type": "string"
      },
      "name": {
        "maxLength": 60,
        "minLength": 1,
        "title": "Name",
        "type": "string"
      },
      "player_id": {
        "exclusiveMinimum": 0,
        "title": "Player Id",
        "type": "integer"
      },
      "role": {
        "enum": [
          "P",
          "D",
          "C",
          "A"
        ],
        "title": "Role",
        "type": "string"
      },
      "source_url": {
        "format": "uri",
        "maxLength": 2083,
        "title": "Source Url",
        "type": "string"
      }
    },
    "required": [
      "player_id",
      "name",
      "club",
      "role",
      "source_url",
      "captured_at",
      "bronze_sha256"
    ],
    "title": "SkeletonPlayerRecord",
    "type": "object"
  },
  "version": "1.0.0"
}
