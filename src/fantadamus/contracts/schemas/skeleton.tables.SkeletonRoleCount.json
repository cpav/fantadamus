{
  "contract": "skeleton.tables.SkeletonRoleCount",
  "schema": {
    "additionalProperties": false,
    "description": "Gold `skeleton_role_counts`: players per club and role, with the source URLs they were read from.",
    "properties": {
      "club": {
        "minLength": 1,
        "title": "Club",
        "type": "string"
      },
      "n_players": {
        "exclusiveMinimum": 0,
        "title": "N Players",
        "type": "integer"
      },
      "role": {
        "enum": [
          "P",
          "D",
          "C",
          "A"
        ],
        "title": "Role",
        "type": "string"
      },
      "source_urls": {
        "description": "Sorted, without duplicates",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Source Urls",
        "type": "array"
      }
    },
    "required": [
      "club",
      "role",
      "n_players",
      "source_urls"
    ],
    "title": "SkeletonRoleCount",
    "type": "object"
  },
  "version": "1.0.0"
}
