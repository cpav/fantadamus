{
  "contract": "xy.lineups.OfficialLineupPayload",
  "schema": {
    "$defs": {
      "OfficialTeam": {
        "additionalProperties": false,
        "properties": {
          "bench": {
            "default": [],
            "description": "The substitutes",
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            "title": "Bench",
            "type": "array"
          },
          "starters": {
            "description": "The 11 starters, less any that `unnamed_starters` counts",
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            "title": "Starters",
            "type": "array"
          },
          "unnamed_starters": {
            "default": 0,
            "description": "A starter the source doesn't name: a page can list only 10 of the 11",
            "maximum": 1,
            "minimum": 0,
            "title": "Unnamed Starters",
            "type": "integer"
          }
        },
        "required": [
          "starters"
        ],
        "title": "OfficialTeam",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "The official lineups of one match, published about an hour before kickoff.",
    "properties": {
      "away": {
        "description": "Away club",
        "maxLength": 60,
        "minLength": 1,
        "title": "Away",
        "type": "string"
      },
      "away_team": {
        "$ref": "#/$defs/OfficialTeam"
      },
      "home": {
        "description": "Home club",
        "maxLength": 60,
        "minLength": 1,
        "title": "Home",
        "type": "string"
      },
      "home_team": {
        "$ref": "#/$defs/OfficialTeam"
      }
    },
    "required": [
      "home",
      "away",
      "home_team",
      "away_team"
    ],
    "title": "OfficialLineupPayload",
    "type": "object"
  },
  "version": "1.1.0"
}
