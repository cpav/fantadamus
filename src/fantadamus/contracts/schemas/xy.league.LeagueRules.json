{
  "contract": "xy.league.LeagueRules",
  "schema": {
    "$defs": {
      "Band": {
        "additionalProperties": false,
        "description": "A range of values and the points it gives: from `from_value` up to the next band's.",
        "properties": {
          "from_value": {
            "description": "This value and up, until the next band",
            "maximum": 100,
            "minimum": -100,
            "title": "From Value",
            "type": "number"
          },
          "points": {
            "description": "The points it gives, from -10 to 10",
            "maximum": 10,
            "minimum": -10,
            "title": "Points",
            "type": "number"
          }
        },
        "required": [
          "from_value",
          "points"
        ],
        "title": "Band",
        "type": "object"
      },
      "EventRow": {
        "additionalProperties": false,
        "description": "What one event is worth to some roles.",
        "properties": {
          "event": {
            "description": "The event",
            "enum": [
              "goal",
              "decisive_goal",
              "assist",
              "set_piece_assist",
              "penalty_scored",
              "penalty_missed",
              "penalty_saved",
              "own_goal",
              "yellow_card",
              "red_card",
              "goal_conceded",
              "clean_sheet"
            ],
            "title": "Event",
            "type": "string"
          },
          "points": {
            "description": "Its points: a bonus from 0 to 10, a malus from -10 to 0",
            "maximum": 10,
            "minimum": -10,
            "title": "Points",
            "type": "number"
          },
          "roles": {
            "description": "Who it applies to: P, D, C and A",
            "items": {
              "enum": [
                "P",
                "D",
                "C",
                "A"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "event",
          "points",
          "roles"
        ],
        "title": "EventRow",
        "type": "object"
      },
      "FormulaRule": {
        "additionalProperties": false,
        "description": "A rule worked out from a round's pure votes after substitutions, such as a modifier or the captain\n(mvp-rules R2.1). Every field is a number or a fixed word, so a rule is data and never code.",
        "properties": {
          "bands": {
            "description": "Rising values and their points; below the first, none",
            "items": {
              "$ref": "#/$defs/Band"
            },
            "minItems": 1,
            "title": "Bands",
            "type": "array"
          },
          "base": {
            "anyOf": [
              {
                "maximum": 11,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How many players the unit counts: its best, or fill with stand-ins",
            "title": "Base"
          },
          "combine": {
            "description": "Average or sum their pure votes, or give each player's own vote its band",
            "enum": [
              "average",
              "sum",
              "each"
            ],
            "title": "Combine",
            "type": "string"
          },
          "leave_out": {
            "default": "nobody",
            "description": "Leave out a player who scored, conceded or saved a penalty",
            "enum": [
              "nobody",
              "bonus_or_goal"
            ],
            "title": "Leave Out",
            "type": "string"
          },
          "name": {
            "description": "What the league calls it",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "stand_in": {
            "default": [],
            "description": "The vote counted for the first missing player, and for the rest; none averages those present",
            "items": {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 2,
            "title": "Stand In",
            "type": "array"
          },
          "who": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/Unit"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "const": "captain",
                "type": "string"
              }
            ],
            "description": "The roles it counts, or the captain",
            "title": "Who"
          }
        },
        "required": [
          "name",
          "who",
          "combine",
          "bands"
        ],
        "title": "FormulaRule",
        "type": "object"
      },
      "LineupRules": {
        "additionalProperties": false,
        "description": "What a lineup needs beyond bonuses and maluses. Any of it may still be unset: the setup step asks for\nwhat is (mvp-lineup R2.2).",
        "properties": {
          "bench_size": {
            "anyOf": [
              {
                "maximum": 25,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Places on the bench",
            "title": "Bench Size"
          },
          "format": {
            "anyOf": [
              {
                "enum": [
                  "head_to_head",
                  "total_points"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Head to head, where thresholds decide; or total points, where they don't",
            "title": "Format"
          },
          "formations": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Allowed formations, as defenders-midfielders-forwards: 3-4-3",
            "title": "Formations"
          },
          "no_rating_vote": {
            "anyOf": [
              {
                "maximum": 10,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The vote a player without a rating keeps when nobody replaces him, if the league gives one",
            "title": "No Rating Vote"
          },
          "other_rules": {
            "default": [],
            "description": "Rules this league uses that Fantadamus leaves out, such as a modifier or a captain; every lineup says its score doesn't include them",
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            "title": "Other Rules",
            "type": "array"
          },
          "substitution_mode": {
            "anyOf": [
              {
                "enum": [
                  "same_role",
                  "role_first",
                  "bench_order"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How a player without a rating is replaced: same role only (the formation never changes); role first, then bench order; or bench order first. The last two may change the formation, into an allowed one",
            "title": "Substitution Mode"
          },
          "substitutions": {
            "anyOf": [
              {
                "maximum": 11,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Substitutions per match",
            "title": "Substitutions"
          },
          "thresholds": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Rising points for the 1st, 2nd and later fantasy goals; past the last, its last step repeats",
            "title": "Thresholds"
          }
        },
        "title": "LineupRules",
        "type": "object"
      },
      "Unit": {
        "additionalProperties": false,
        "description": "Players of one role that a formula rule counts.",
        "properties": {
          "at_least": {
            "anyOf": [
              {
                "maximum": 11,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The rule gives points only when at least this many are fielded",
            "title": "At Least"
          },
          "at_most": {
            "anyOf": [
              {
                "maximum": 11,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "And only when at most this many are",
            "title": "At Most"
          },
          "best": {
            "anyOf": [
              {
                "maximum": 11,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only his role's best n by pure vote; leave out to count them all",
            "title": "Best"
          },
          "role": {
            "description": "P, D, C or A",
            "enum": [
              "P",
              "D",
              "C",
              "A"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "Unit",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A league's rules: one table of events, and what a lineup needs. An event left out isn't scored.",
    "properties": {
      "events": {
        "description": "Every event this league scores, with its points and the roles they apply to. An event left out isn't scored. For different values by role, give one row per value",
        "items": {
          "$ref": "#/$defs/EventRow"
        },
        "minItems": 1,
        "title": "Events",
        "type": "array"
      },
      "formula_rules": {
        "default": [],
        "description": "Rules worked out from a round's pure votes after substitutions: modifiers, the captain",
        "items": {
          "$ref": "#/$defs/FormulaRule"
        },
        "title": "Formula Rules",
        "type": "array"
      },
      "lineup": {
        "anyOf": [
          {
            "$ref": "#/$defs/LineupRules"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "What a lineup needs: thresholds, the bench, substitutions and formations. Not needed for 'X or Y?'. A call without it, or with only some of it, keeps what's stored"
      }
    },
    "required": [
      "events"
    ],
    "title": "LeagueRules",
    "type": "object"
  },
  "version": "2.1.1"
}
